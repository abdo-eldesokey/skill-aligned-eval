# OpenAI API key — required for the LLM evaluation script and the
# image-evaluation app's automated annotation feature.
OPENAI_API_KEY=

# Runware API key — only needed if you re-run scripts/generate_images_runware.py
# to regenerate the dataset images. Leave blank otherwise.
RUNWARE_API_KEY=

# Optional image-search keys used by scripts/generate_and_download_anchors.py
# when sourcing reference anchor images. Leave blank to skip those providers.
SERPER_API_KEY=
GOOGLE_CSE_ID=
BING_SEARCH_KEY=

# Optional override for the image-evaluation app port (default: 5002).
PORT=
